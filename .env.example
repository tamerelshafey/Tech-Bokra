# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Company Public Contacts & Legal Identifiers (B2B Egypt Verification)
NEXT_PUBLIC_COMPANY_PHONE="+20 101 234 5678"
NEXT_PUBLIC_COMPANY_WHATSAPP="201012345678"
NEXT_PUBLIC_COMPANY_EMAIL="Support@tech-bokra.com"
NEXT_PUBLIC_COMPANY_CR="[TO_CONFIRM_CR]"
NEXT_PUBLIC_COMPANY_TAX_ID="[TO_CONFIRM_TAX_ID]"

# ADMIN_SESSION_SECRET: Mandatory server secret used to sign HMAC-SHA256 admin session cookies.
# Set a strong random cryptographic string in production (e.g., openssl rand -hex 32).
ADMIN_SESSION_SECRET="MY_ADMIN_SESSION_SECRET"

# ADMIN_ALLOWED_EMAILS: Comma-separated list of authorized administrator emails.
ADMIN_ALLOWED_EMAILS="tam.elshafey@gmail.com,admin@tech-bokra.com"

